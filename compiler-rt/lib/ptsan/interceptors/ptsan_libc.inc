// This file is a part of PointerTagSanitizer.
//
// Id-aware wrappers for sanitizer_libc.h functions.
//
//===----------------------------------------------------------------------===//
// Redefine each of the sanitizer_libc.h functions to correctly strip/propagate ids
// Generated by chatGPT. Thanks ChatGPT!

// 1) internal_atoll(const char* nptr) -> s64
//    single pointer param, returns non-pointer => no copy_id
#define internal_atoll_common(...) internal_atoll(__VA_ARGS__)
#define internal_atoll(nptr) \
  internal_atoll_common(clear_id(nptr))

// 2) internal_memchr(const void *s, int c, uptr n) -> void*
//    returns pointer presumably inside s
#define internal_memchr_common(...) internal_memchr(__VA_ARGS__)
#define internal_memchr(s, c, n) \
  copy_id(internal_memchr_common(clear_id(s), (c), (n)), s)

// 3) internal_memrchr(const void *s, int c, uptr n) -> void*
//    returns pointer presumably inside s
#define internal_memrchr_common(...) internal_memrchr(__VA_ARGS__)
#define internal_memrchr(s, c, n) \
  copy_id(internal_memrchr_common(clear_id(s), (c), (n)), s)

// 4) internal_memcmp(const void* s1, const void* s2, uptr n) -> int
//    no pointer return => no copy_id
#define internal_memcmp_common(...) internal_memcmp(__VA_ARGS__)
#define internal_memcmp(s1, s2, n) \
  internal_memcmp_common(clear_id(s1), clear_id(s2), (n))

// 5) internal_memcpy(void *dest, const void *src, uptr n) -> void*
//    returns 'dest'
#define internal_memcpy_common(...) internal_memcpy(__VA_ARGS__)
#define internal_memcpy(dest, src, n) \
  copy_id(internal_memcpy_common(clear_id(dest), clear_id(src), (n)), dest)

// 6) internal_memmove(void *dest, const void *src, uptr n) -> void*
//    returns 'dest'
#define internal_memmove_common(...) internal_memmove(__VA_ARGS__)
#define internal_memmove(dest, src, n) \
  copy_id(internal_memmove_common(clear_id(dest), clear_id(src), (n)), dest)

// 7) internal_memset(void *s, int c, uptr n) -> void*
//    returns 's'
#define internal_memset_common(...) internal_memset(__VA_ARGS__)
#define internal_memset(s, c, n) \
  copy_id(internal_memset_common(clear_id(s), (c), (n)), s)

// 8) internal_strchr(const char *s, int c) -> char*
//    returns pointer presumably in s
#define internal_strchr_common(...) internal_strchr(__VA_ARGS__)
#define internal_strchr(s, c) \
  copy_id(internal_strchr_common(clear_id(s), (c)), s)

// 9) internal_strchrnul(const char *s, int c) -> char*
//    returns pointer presumably in s
#define internal_strchrnul_common(...) internal_strchrnul(__VA_ARGS__)
#define internal_strchrnul(s, c) \
  copy_id(internal_strchrnul_common(clear_id(s), (c)), s)

// 10) internal_strcmp(const char *s1, const char *s2) -> int
#define internal_strcmp_common(...) internal_strcmp(__VA_ARGS__)
#define internal_strcmp(s1, s2) \
  internal_strcmp_common(clear_id(s1), clear_id(s2))

// 11) internal_strcspn(const char *s, const char *reject) -> uptr
#define internal_strcspn_common(...) internal_strcspn(__VA_ARGS__)
#define internal_strcspn(s, reject) \
  internal_strcspn_common(clear_id(s), clear_id(reject))

// 12) internal_strdup(const char *s) -> char*
//    possibly returning a new pointer.
//    If you want to unify top bits with 's', do copy_id(..., s)
#define internal_strdup_common(...) internal_strdup(__VA_ARGS__)
#define internal_strdup(s) \
  internal_strdup_common(clear_id(s));

// 13) internal_strlen(const char *s) -> uptr
#define internal_strlen_common(...) internal_strlen(__VA_ARGS__)
#define internal_strlen(s) \
  internal_strlen_common(clear_id(s))

// 14) internal_strlcat(char *dst, const char *src, uptr maxlen) -> uptr
//     No pointer return => no copy_id
#define internal_strlcat_common(...) internal_strlcat(__VA_ARGS__)
#define internal_strlcat(dst, src, maxlen) \
  internal_strlcat_common(clear_id(dst), clear_id(src), (maxlen))

// 15) internal_strncat(char *dst, const char *src, uptr n) -> char*
//     returns 'dst' pointer
#define internal_strncat_common(...) internal_strncat(__VA_ARGS__)
#define internal_strncat(dst, src, n) \
  copy_id(internal_strncat_common(clear_id(dst), clear_id(src), (n)), dst)

// 16) internal_strncmp(const char *s1, const char *s2, uptr n) -> int
#define internal_strncmp_common(...) internal_strncmp(__VA_ARGS__)
#define internal_strncmp(s1, s2, n) \
  internal_strncmp_common(clear_id(s1), clear_id(s2), (n))

// 17) internal_strlcpy(char *dst, const char *src, uptr maxlen) -> uptr
//     no pointer return => no copy_id
#define internal_strlcpy_common(...) internal_strlcpy(__VA_ARGS__)
#define internal_strlcpy(dst, src, maxlen) \
  internal_strlcpy_common(clear_id(dst), clear_id(src), (maxlen))

// 18) internal_strncpy(char *dst, const char *src, uptr n) -> char*
//     returns 'dst'
#define internal_strncpy_common(...) internal_strncpy(__VA_ARGS__)
#define internal_strncpy(dst, src, n) \
  copy_id(internal_strncpy_common(clear_id(dst), clear_id(src), (n)), dst)

// 19) internal_strnlen(const char *s, uptr maxlen) -> uptr
//     no pointer return => no copy_id
#define internal_strnlen_common(...) internal_strnlen(__VA_ARGS__)
#define internal_strnlen(s, maxlen) \
  internal_strnlen_common(clear_id(s), (maxlen))

// 20) internal_strrchr(const char *s, int c) -> char*
//     presumably a pointer within s
#define internal_strrchr_common(...) internal_strrchr(__VA_ARGS__)
#define internal_strrchr(s, c) \
  copy_id(internal_strrchr_common(clear_id(s), (c)), s)

// 21) internal_strstr(const char *haystack, const char *needle) -> char*
//     pointer into haystack
#define internal_strstr_common(...) internal_strstr(__VA_ARGS__)
#define internal_strstr(haystack, needle) \
  copy_id(internal_strstr_common(clear_id(haystack), clear_id(needle)), haystack)

// 22) internal_simple_strtoll(const char *nptr, const char **endptr, int base) -> s64
//     The 'endptr' param is pointer to pointer, might want to strip the pointer
//     but the function returns s64 => no copy_id
#define internal_simple_strtoll_common(...) internal_simple_strtoll(__VA_ARGS__)
#define internal_simple_strtoll(nptr, endptr, base) \
  CHECK(false && "handle_strtoll")
  //internal_simple_strtoll_common(clear_id(nptr), clear_id(endptr), (base))

// 23) internal_snprintf(char *buffer, uptr length, const char *format, ...) -> int
//     We can't do varargs rewriting easily. But for the pointers we do see:
#define internal_snprintf_common(...) internal_snprintf(__VA_ARGS__)
#define internal_snprintf(buffer, length, format, ...) \
  CHECK(false && "handle_snprintf")
  //internal_snprintf_common(clear_id(buffer), (length), clear_id(format), ##__VA_ARGS__)

// 24) internal_wcslen(const wchar_t *s) -> uptr
#define internal_wcslen_common(...) internal_wcslen(__VA_ARGS__)
#define internal_wcslen(s) \
  internal_wcslen_common(clear_id(s))

// 25) internal_wcsnlen(const wchar_t *s, uptr maxlen) -> uptr
#define internal_wcsnlen_common(...) internal_wcsnlen(__VA_ARGS__)
#define internal_wcsnlen(s, maxlen) \
  internal_wcsnlen_common(clear_id(s), (maxlen))

// 26) internal_wcscpy(wchar_t *dst, const wchar_t *src) -> wchar_t*
//     returns 'dst'
#define internal_wcscpy_common(...) internal_wcscpy(__VA_ARGS__)
#define internal_wcscpy(dst, src) \
  copy_id(internal_wcscpy_common(clear_id(dst), clear_id(src)), dst)

// 27) internal_wcsncpy(wchar_t *dst, const wchar_t *src, uptr maxlen) -> wchar_t*
//     returns 'dst'
#define internal_wcsncpy_common(...) internal_wcsncpy(__VA_ARGS__)
#define internal_wcsncpy(dst, src, maxlen) \
  copy_id(internal_wcsncpy_common(clear_id(dst), clear_id(src), (maxlen)), dst)

// 28) mem_is_zero(const char *mem, uptr size) -> bool
#define mem_is_zero_common(...) mem_is_zero(__VA_ARGS__)
#define mem_is_zero(mem, size) \
  mem_is_zero_common(clear_id(mem), (size))

// 29) internal_ftruncate(fd_t fd, uptr size) -> uptr
//     no pointer param => no macro needed, unless you want to do something else.

// 30) internal__exit(int exitcode) -> NORETURN
//     no pointer => no special macro needed

// 31) internal_sleep(unsigned seconds) -> void
//     no pointer => no special macro needed

// 32) internal_usleep(u64 useconds) -> void
//     no pointer => no special macro needed

// 33) internal_getpid(), internal_getppid() -> uptr
//     no pointer => no special macro needed

// 34) internal_dlinfo(void *handle, int request, void *p) -> int
#define internal_dlinfo_common(...) internal_dlinfo(__VA_ARGS__)
#define internal_dlinfo(handle, request, p) \
  internal_dlinfo_common(clear_id(handle), (request), clear_id(p))

// 35) internal_sched_yield() -> uptr
//     no pointer => no special macro needed

// 36) internal_iserror(uptr retval, int *rverrno=nullptr) -> bool
#define internal_iserror_common(...) internal_iserror(__VA_ARGS__)
#define internal_iserror(retval, rverrno) \
  internal_iserror_common((retval), clear_id(rverrno))

